# Google Drive Credentials
# Download client_secrets.json from Google Cloud Console and save it in scripts/
CLIENT_SECRETS_FILE=client_secrets.json

# ID of the Google Drive folder where notebooks will be uploaded
# Leave empty to create a new folder named 'Colab_Notebooks'
DRIVE_FOLDER_ID=

# Optional: Set to true to make uploaded files public (view only)
MAKE_PUBLIC=false
